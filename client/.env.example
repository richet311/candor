VITE_API_URL=http://localhost:4000/api

# Same Google OAuth Web client ID configured on the server (GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Set to true when GitHub sign-in is configured on the server (GITHUB_CLIENT_ID/SECRET), so the
# button renders with the page instead of waiting for the API to report it.
VITE_GITHUB_SIGNIN_ENABLED=
