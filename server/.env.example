NODE_ENV=development
PORT=4000
API_ORIGIN=http://localhost:4000

DATABASE_URL=postgresql://candor:candor_dev_only@localhost:5433/candor
# Used by `prisma migrate` only, must be an unpooled connection (see schema.prisma). Locally
# there's no pooler in front of Docker Postgres, so this is just the same value as above; in
# production point it at Neon's "Direct connection" string, not the pooled one DATABASE_URL uses.
DIRECT_URL=postgresql://candor:candor_dev_only@localhost:5433/candor

CLIENT_ORIGIN=http://localhost:5173

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Stripe test keys from dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# All sign-in providers below are optional and independent. GET /api/auth/oauth/providers
# reports which are configured, and the login/register pages only render buttons for those.

# Google OAuth client ID from console.cloud.google.com (Web application credential)
GOOGLE_CLIENT_ID=

# GitHub OAuth App from github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Without this, verification/receipt/new-device-login emails are logged to the
# server console instead of sent, so the app still runs end-to-end with nothing set up here.
# Free API key from resend.com. Their sandbox sender (the default below) can only deliver to
# the email you signed up to Resend with; verify a domain there to send to anyone else.
RESEND_API_KEY=
EMAIL_FROM=Candor <onboarding@resend.dev>

# Optional locally - uploaded avatars/org logos fall back to local disk (server/uploads)
# when unset, which is fine for dev. Required in production (see config/env.ts), since
# Render's filesystem doesn't survive a restart. Cloudflare R2 bucket + S3-compatible
# API token from dash.cloudflare.com > R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
